// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`GamePage for a game without a board > renders the page exactly as before the board subsystem existed 1`] = `"<main class="page game-page"><section class="page-heading game-heading"><div><p class="eyebrow">Active</p><h1>Friday table</h1><p class="lede">Pass GO reward $200</p><span class="live-status live-status-connecting" role="status">Connecting…</span></div><div class="header-actions"><button class="button button-danger" type="button">Finish game</button><button class="button button-secondary" type="button">Activity</button><button class="button button-secondary" type="button">Statistics</button><button class="button button-quiet" type="button">Saved games</button></div></section><fieldset class="wallet-switcher"><legend>Choose the wallet to control</legend><div><button class="button button-secondary" type="button" aria-pressed="true">Primary wallet: Ada</button></div></fieldset><section class="primary-wallet" aria-label="Ada's wallet"><p>Your wallet</p><button class="wallet-card wallet-card-button wallet-card-active wallet-card-prominent" type="button" style="border-top-color: rgb(216, 63, 85);" aria-label="Ada, balance $1 500. Open banking actions."><span class="player-color" style="background-color: rgb(216, 63, 85);" aria-hidden="true"></span><span class="wallet-name">Ada</span><strong>$1 500</strong><span class="wallet-action">Tap for banking actions</span><span class="wallet-active-indicator">Active wallet</span></button></section><section class="wallet-grid" aria-label="Player wallets"><article class="wallet-card wallet-card-readonly" style="border-top-color: rgb(40, 120, 208);" aria-label="Bob, balance $1 200. Read-only wallet."><span class="player-color" style="background-color: rgb(40, 120, 208);" aria-hidden="true"></span><span class="wallet-name">Bob</span><strong>$1 200</strong><span class="wallet-action">Read-only wallet</span></article></section><section class="payment-inbox banknote-panel" aria-labelledby="payment-inbox-title"><header><h2 id="payment-inbox-title">Payment inbox</h2><span class="status-pill">0</span></header><p class="muted">No payment requests waiting for you.</p></section><div class="game-tools"><section class="dice-roller" aria-label="Dice roller"><div><p class="eyebrow">Table tool</p><h2>Roll dice</h2><p class="muted">Standalone — it does not change the game.</p></div><div class="dice-results" aria-live="polite"><span class="die die-1" aria-label="Die: 1"><i></i></span><span class="die die-1" aria-label="Die: 1"><i></i></span><strong>Total 2</strong><span class="double">DOUBLE!</span></div><button class="button button-primary dice-button" type="button">Roll dice</button></section><section class="table-calculator" aria-label="Calculator"><div><p class="eyebrow">Table tool</p><h2>Calculator</h2><p class="muted">For quick table math — it never changes balances.</p></div><div class="calculator-controls"><input aria-label="First number" inputmode="decimal" value=""><div class="calculator-operations" role="group" aria-label="Operation"><button type="button" class="" aria-pressed="false">+</button><button type="button" class="" aria-pressed="false">−</button><button type="button" class="selected" aria-pressed="true">×</button><button type="button" class="" aria-pressed="false">÷</button></div><input aria-label="Second number" inputmode="decimal" value=""><output aria-live="polite">= —</output></div></section></div></main>"`;
