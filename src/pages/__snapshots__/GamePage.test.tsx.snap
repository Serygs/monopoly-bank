// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`GamePage for a game without a board > renders the page exactly as before the board subsystem existed 1`] = `"<main class="page game-page"><section class="page-header game-heading"><div class="page-header-content"><div class="page-header-back"><button class="button button-quiet game-back-link" type="button"><span aria-hidden="true">←</span>Saved games</button></div><p class="eyebrow">Active</p><h1>Friday table</h1><div class="lede"><span class="game-pass-go"><span>Pass GO reward:</span><strong>$200</strong></span></div><span class="live-status live-status-connecting" role="status">Connecting…</span></div><div class="page-header-actions"><div class="game-page-actions"><button class="button button-secondary" type="button">Activity</button><button class="button button-secondary" type="button">Statistics</button><button class="button button-danger" type="button">Finish game</button></div></div></section><section class="wallets-section" aria-labelledby="player-wallets-title"><header class="wallets-heading"><h2 id="player-wallets-title">Player wallets</h2></header><fieldset class="wallet-switcher"><legend>Choose the wallet to control</legend><div><button class="button button-secondary" type="button" aria-pressed="true">Primary wallet: Ada</button></div></fieldset><div class="wallet-layout"><section class="wallet-group wallet-group-controlled" aria-label="Ada's wallet"><h3>Your wallet</h3><button class="wallet-card wallet-card-button wallet-card-active wallet-card-prominent" type="button" style="--wallet-player-color: #d83f55;" aria-label="Ada, balance $1 500. Open banking actions."><span class="wallet-card-heading"><span class="player-color" style="background-color: rgb(216, 63, 85);" aria-hidden="true"></span><span class="wallet-name">Ada</span><span class="wallet-card-badges"><span class="wallet-active-indicator">Active wallet</span></span></span><strong class="wallet-balance">$1 500</strong><span class="wallet-card-footer"><span>Open banking actions</span><span aria-hidden="true">→</span></span></button></section><div class="wallet-group wallet-group-others"><h3>Other players</h3><div class="wallet-grid"><article class="wallet-card wallet-card-readonly" style="--wallet-player-color: #2878d0;" aria-label="Bob, balance $1 200. Read-only wallet."><span class="wallet-card-heading"><span class="player-color" style="background-color: rgb(40, 120, 208);" aria-hidden="true"></span><span class="wallet-name">Bob</span><span class="wallet-card-badges"></span></span><strong class="wallet-balance">$1 200</strong><span class="wallet-card-footer"><span>Read-only wallet</span></span></article></div></div></div></section><section class="payment-inbox" aria-labelledby="payment-inbox-title"><header><h2 id="payment-inbox-title">Payment inbox</h2><span class="status-pill">0</span></header><p class="muted">No payment requests waiting for you.</p></section><div class="game-tools"><section class="dice-roller" aria-label="Dice roller"><div><p class="eyebrow">Table tool</p><h2>Roll dice</h2><p class="muted">Standalone — it does not change the game.</p></div><div class="dice-results" aria-live="polite"><span class="die die-1" aria-label="Die: 1"><i></i></span><span class="die die-1" aria-label="Die: 1"><i></i></span><strong>Total 2</strong><span class="double">DOUBLE!</span></div><button class="button button-primary dice-button" type="button">Roll dice</button></section><section class="table-calculator" aria-label="Calculator"><div><p class="eyebrow">Table tool</p><h2>Calculator</h2><p class="muted">For quick table math — it never changes balances.</p></div><div class="calculator-controls"><input aria-label="First number" inputmode="decimal" value=""><div class="calculator-operations" role="group" aria-label="Operation"><button type="button" class="" aria-pressed="false">+</button><button type="button" class="" aria-pressed="false">−</button><button type="button" class="selected" aria-pressed="true">×</button><button type="button" class="" aria-pressed="false">÷</button></div><input aria-label="Second number" inputmode="decimal" value=""><output aria-live="polite">= —</output></div></section></div></main>"`;
